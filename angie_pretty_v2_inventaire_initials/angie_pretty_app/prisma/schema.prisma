generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
  BILLING
  WAREHOUSE
  DISPATCH_TANA
  DISPATCH_PROVINCE
  FEEDBACK_TANA
  FEEDBACK_PROVINCE
}

enum Destination {
  TANA
  PROVINCE
}

enum OrderStatus {
  NEW
  CONFIRMED
  TO_INVOICE
  INVOICED
  PREPARING
  READY_TO_DISPATCH
  DISPATCHED
  DELIVERED
  DELIVERY_FAILED
  CANCELLED
  RETURN_REQUESTED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  TO_VERIFY
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  SALE
  RETURN
  ADJUSTMENT
}

enum ParcelStatus {
  TO_PREPARE
  PREPARING
  READY
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum DispatchFeedbackStatus {
  TO_DELIVER
  SOLD
  RETURN
}

enum FeedbackStatus {
  TO_CONTACT
  CONTACTED
  SATISFIED
  COMPLAINT
  RETURN_REQUESTED
  UNREACHABLE
  FOLLOW_UP
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(SALES)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  orders       Order[]  @relation("SalesOrders")
  movements    StockMovement[]
  activity     AuditLog[]
  dispatchSheets DispatchSheet[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String
  city      String
  notes     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  category    String
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  variants    Variant[]
}

model Variant {
  id           String          @id @default(cuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  sku          String          @unique
  model        String
  size         String
  color        String
  unitPrice    Int
  purchasePrice Int            @default(0)
  stockOnHand  Int             @default(0)
  stockReserved Int            @default(0)
  alertAt      Int             @default(3)
  orderLines   OrderLine[]
  movements    StockMovement[]
  createdAt    DateTime        @default(now())
  @@unique([productId, model, size, color])
}

model Order {
  id            String      @id @default(cuid())
  number        String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  salesUserId   String
  salesUser     User        @relation("SalesOrders", fields: [salesUserId], references: [id])
  destination   Destination
  deliveryAddress String
  status        OrderStatus @default(NEW)
  paymentStatus PaymentStatus @default(UNPAID)
  subtotal      Int
  deliveryFee   Int         @default(0)
  discount      Int         @default(0)
  total         Int
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lines         OrderLine[]
  invoice       Invoice?
  parcel        Parcel?
  feedback      Feedback[]
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Int
  lineTotal Int
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id])
  status      InvoiceStatus @default(ISSUED)
  total       Int
  amountPaid  Int           @default(0)
  issuedAt    DateTime      @default(now())
  payments    Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Int
  method    String
  reference String?
  paidAt    DateTime @default(now())
  note      String?
}

model StockMovement {
  id        String            @id @default(cuid())
  variantId String
  variant   Variant           @relation(fields: [variantId], references: [id])
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  type      StockMovementType
  quantity  Int
  reason    String
  orderId   String?
  createdAt DateTime           @default(now())
}

model Parcel {
  id            String       @id @default(cuid())
  orderId       String       @unique
  order         Order        @relation(fields: [orderId], references: [id])
  destination   Destination
  status        ParcelStatus @default(TO_PREPARE)
  carrier       String?
  trackingCode  String?
  packedAt      DateTime?
  dispatchedAt  DateTime?
  deliveredAt   DateTime?
  stockIssuedAt DateTime?
  dispatchItems DispatchSheetItem[]
  notes         String?
}

model DispatchSheet {
  id          String              @id @default(cuid())
  sheetNumber String              @unique
  axis        String
  driverName  String
  assembledAt DateTime            @default(now())
  createdById String?
  createdBy   User?               @relation(fields: [createdById], references: [id])
  items       DispatchSheetItem[]
}

model DispatchSheetItem {
  id        String        @id @default(cuid())
  sheetId   String
  sheet     DispatchSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  parcelId  String
  parcel    Parcel        @relation(fields: [parcelId], references: [id])
  feedbackStatus DispatchFeedbackStatus @default(TO_DELIVER)
  feedbackUpdatedAt DateTime?
  createdAt DateTime      @default(now())
  @@unique([sheetId, parcelId])
}

model Feedback {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id])
  status      FeedbackStatus @default(TO_CONTACT)
  team        Destination
  contactedAt DateTime?
  result      String?
  nextAction  String?
  nextAt      DateTime?
  createdAt   DateTime      @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
}
